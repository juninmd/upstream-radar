{
  "name": "upstream-radar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Monta a watchlist a partir das dependências que você realmente usa nos seus repos e avisa no Telegram só as releases que te afetam.",
  "scripts": {
    "dev": "bun run src/index.ts --watchlist",
    "start": "bun run src/index.ts --loop",
    "radar": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@juninmd/digest-kit": "^0.4.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node-cron": "^3.0.11",
    "typescript": "^5.7.3"
  }
}
